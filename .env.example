# ---------- Model provider (swap providers by changing env only) ----------
# Read ONLY from env. Never commit a real key.
MODEL_API_KEY=
LLM_PROVIDER=responses            # responses (Meta Model API, default) | chat (any OpenAI-compatible) | scripted (offline tests/e2e)
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3
LLM_FALLBACK_MODEL=muse-spark-1.1
LLM_EFFORT=high
# Sentinel uses its own credentials (falls back to MODEL_API_KEY if empty)
SENTINEL_MODEL_API_KEY=
SENTINEL_MODEL=muse-spark-1.3
# Contributor mode: users may opt IN (with explicit consent) to Meta's lower-cost Contributor-mode models, which
# allow Meta to use their content for training. Off for every user by default; set to false to hide it entirely.
ALLOW_CONTRIBUTOR_MODE=true

# ---------- Embeddings (Model API has none; default is local hashing) ----------
EMBEDDINGS_PROVIDER=hash          # hash | openai-compatible
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# ---------- Data (EU / local by default) ----------
DATA_REGION=eu
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://muse:change-me@localhost:5432/muse
SENTINEL_DB_PASSWORD=change-me-too
SENTINEL_DATABASE_URL=postgres://muse_sentinel:change-me-too@localhost:5432/muse
REDIS_URL=redis://localhost:6379

# ---------- Secrets generated by `pnpm gen:keys` ----------
JWT_SECRET=
VAULT_MASTER_KEY=
SENTINEL_PRIVATE_KEY=
SENTINEL_PUBLIC_KEY=
EXECUTOR_PRIVATE_KEY=
EXECUTOR_PUBLIC_KEY=
SENTINEL_CLIENT_TOKEN=
INTERNAL_TOKEN=
SANDBOX_PROXY_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- URLs ----------
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
SENTINEL_URL=http://localhost:4100
EXECUTOR_URL=http://localhost:4000

# ---------- Google connectors (optional; Demo Mail/Calendar work without) ----------
# You can leave these empty: each user can paste their own Google OAuth client in the app
# (Connections → Set up Google), with a step-by-step guide. Values here act as a server-wide default.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Sandbox browser ----------
SANDBOX_DRIVER=local              # docker | local
SANDBOX_IMAGE=muse-sandbox:latest
SANDBOX_NETWORK=muse-sandbox
SANDBOX_RUNTIME=                  # e.g. runsc (gVisor) for stronger isolation
EGRESS_PROXY_URL=http://localhost:8899
EGRESS_UPSTREAM_PROXY=            # only if your network requires an outbound proxy
EGRESS_ALLOW_PRIVATE_HOSTS=       # e.g. host.docker.internal for local fixtures
SENTINEL_BLOCKED_DOMAINS=

# ---------- Payments (test mode only; no real money) ----------
PAYMENT_PROVIDER=virtual-card-stub   # virtual-card-stub | stripe-test
STRIPE_TEST_SECRET_KEY=              # must start with sk_test_
SPEND_LIMIT_CENTS=50000

# ---------- Voice ----------
STT_PROVIDER=meta                 # meta (muse-voice-transcribe-1.0) | none
# Text-to-speech. "local" = natural neural voices (Kokoro-82M, Apache-2.0) generated inside the API: free, private,
# human-sounding. The model (~90 MB) downloads once from Hugging Face on first start.
# "openai-compatible" = any /v1/audio/speech server (e.g. Kokoro-FastAPI, OpenAI). "device" = on-device voices only.
TTS_PROVIDER=local
TTS_CACHE_DIR=                    # where the voice model is cached (docker compose uses the "models" volume)
TTS_DTYPE=q8                      # q8 (fast, default) | fp32 (slightly better, slower) | q4
TTS_PRELOAD=true                  # warm the model at startup so the first spoken reply is quick
TTS_BASE_URL=                     # openai-compatible only
TTS_API_KEY=
TTS_MODEL=                        # openai-compatible: model name; local: Hugging Face model id (default onnx-community/Kokoro-82M-v1.0-ONNX)
TTS_VOICE=                        # openai-compatible only: force one voice (else the user's chosen natural voice id)
# ElevenLabs: each user pastes their OWN API key in the app (Settings → Voice; free plan works). Nothing to set here.
ELEVENLABS_BASE_URL=              # optional override (default https://api.elevenlabs.io)

# ---------- Push ----------
EXPO_ACCESS_TOKEN=

# ---------- Background jobs ----------
PROACTIVE_INTERVAL_MIN=240
