{
  "expo": {
    "name": "Free Muse",
    "slug": "free-muse",
    "scheme": "freemuse",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": { "bundleIdentifier": "local.personal.freemuse", "supportsTablet": true, "infoPlist": { "NSMicrophoneUsageDescription": "Talk to your agent with your voice." } },
    "android": { "package": "local.personal.freemuse", "permissions": ["RECORD_AUDIO", "POST_NOTIFICATIONS"] },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", { "color": "#6B4E31" }],
      ["expo-audio", { "microphonePermission": "Talk to your agent with your voice." }]
    ],
    "extra": { "apiUrl": "http://10.0.2.2:4000" },
    "experiments": { "typedRoutes": false }
  }
}
